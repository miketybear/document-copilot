# Read by docker-compose.yml only (build-arg / Caddy interpolation) — copy to `.env`.
# Runtime secrets still live in backend/.env and frontend/.env; see
# docs/guides/deploy-onprem.md for the full setup sequence.

# Public hostname the reverse proxy answers on. A real DNS name gets an automatic
# Let's Encrypt cert; "localhost" or an internal-only name gets Caddy's internal CA;
# use ":80" if a company-managed edge already terminates TLS in front of this host.
DOMAIN=localhost

# --- Frontend build args (must match the values in frontend/.env — see comment there) ---
VITE_API_BASE_URL=https://localhost/api
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
VITE_SSO_PROVIDERS=
