# Supabase: Dashboard → Project Settings → API
# Database: Dashboard → Project Settings → Database → Connection string

# --- Supabase (Auth + API) ---

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# --- Postgres (Alembic + direct DB access) ---

# Use the DIRECT connection (host: db.<ref>.supabase.co).
# Do NOT use the transaction pooler URL (pooler.supabase.com) — migrations require a session connection.
# URL-encode special characters in the password.
DATABASE_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres

# --- Azure OpenAI (needed once the LLM / embedding layer is wired up) ---

# Classic Azure OpenAI REST endpoint (bare resource root, *.cognitiveservices.azure.com or
# *.services.ai.azure.com both work). Must NOT include a /openai/v1 or /api/projects/... path —
# the AzureOpenAI SDK client builds the full deployment path itself.
AZURE_OPENAI_ENDPOINT=https://your-resource.cognitiveservices.azure.com
AZURE_OPENAI_API_KEY=your-azure-openai-key
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_DEPLOYMENT=your-chat-deployment-name
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=your-embedding-deployment-name
AZURE_OPENAI_EMBEDDING_DIMENSIONS=1536

# --- Server ---

# Comma-separated browser origins allowed to call the API (CORS).
ALLOWED_ORIGINS=http://localhost:5173

# Comma-separated emails granted admin access (currently: managing MCP connections). Re-checked
# on every login — no separate role-management UI, just edit this and sign in again.
ADMIN_EMAILS=

# --- MCP connections ---

# Fernet key encrypting stored MCP connection credentials at rest. Generate a fresh one per
# environment (never reuse the same key across dev/prod) with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MCP_TOKEN_ENCRYPTION_KEY=your-generated-fernet-key

# The externally-reachable base URL for this backend's own API — used to build the OAuth
# redirect_uri an authorization server redirects the user's browser back to, so it must be a
# public HTTPS URL, not an internal Docker service name. Behind this repo's reverse-proxy setup
# that's `https://<DOMAIN>/api` (Caddy strips the /api prefix — see reverse-proxy/Caddyfile),
# matching VITE_API_BASE_URL. For local dev without the proxy, http://localhost:8000 is fine.
BACKEND_BASE_URL=https://your-domain/api
