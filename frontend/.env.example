# Supabase: Dashboard → Project Settings → API
# Only public (browser-safe) values belong here — never the service_role key or database URL.

# --- Backend API ---

VITE_API_BASE_URL=http://localhost:8000

# --- Supabase (browser auth) ---

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Comma-separated list of SSO buttons to show on the sign-in page, e.g. "azure" or "azure,google".
# Leave empty for email/password only. Each provider must be enabled in Supabase Dashboard →
# Authentication → Providers first — see docs/guides/sso-setup.md.
VITE_SSO_PROVIDERS=
